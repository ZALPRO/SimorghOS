# سیمرغ‌اواس — اسکریپت اسپلش Plymouth
Window.SetBackgroundTopColor(0.067, 0.067, 0.106);
Window.SetBackgroundBottomColor(0.118, 0.118, 0.180);

logo = Image("splash.png");
logo_sprite = Sprite(logo);
logo_sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - logo.GetWidth() / 2,
                        Window.GetY() + Window.GetHeight() / 2 - logo.GetHeight() / 2 - 40,
                        1);

title = Image.Text("سیمرغ‌اواس در حال پرواز…", 0.580, 0.886, 0.835, 1);
title_sprite = Sprite(title);
title_sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - title.GetWidth() / 2,
                         Window.GetY() + Window.GetHeight() / 2 + 80, 1);

bar_width = 320;
bar_height = 6;
progress = 0;

bar_bg = Image.Rect(bar_width, bar_height, 0.19, 0.20, 0.28, 1);
bar_bg_sprite = Sprite(bar_bg);
bar_bg_sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - bar_width / 2,
                          Window.GetY() + Window.GetHeight() / 2 + 120, 0);

fun refresh_bar () {
    global.bar_fg_sprite = Sprite(Image.Rect(Math.Int(bar_width * global.progress), bar_height, 0.580, 0.886, 0.835, 1));
    global.bar_fg_sprite.SetPosition(Window.GetX() + Window.GetWidth() / 2 - bar_width / 2,
                                     Window.GetY() + Window.GetHeight() / 2 + 120, 2);
}

fun display_normal_callback () {
    global.progress = 0.9;
    refresh_bar();
}

fun display_password_callback (prompt, bullets) {
    refresh_bar();
}

fun boot_progress_callback (duration, fraction) {
    global.progress = fraction;
    refresh_bar();
}

Plymouth.SetDisplayNormalCallback(display_normal_callback);
Plymouth.SetDisplayPasswordCallback(display_password_callback);
Plymouth.SetBootProgressCallback(boot_progress_callback);
refresh_bar();
