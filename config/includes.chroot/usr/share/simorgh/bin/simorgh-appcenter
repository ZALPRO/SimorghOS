#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────
#  SimorghOS 0.0.1 — App Center / مرکز نرم‌افزار سیمرغ
#  نصب یک‌کلیکی از Flathub + جست‌وجو + نصب با شناسهٔ دلخواه
# ─────────────────────────────────────────────────────────────
set -uo pipefail
R="rofi -dmenu -i -p"

declare -A APPS=(
  [LibreOffice]="org.libreoffice.LibreOffice"
  [VLC]="org.videolan.VLC"
  [GIMP]="org.gimp.GIMP"
  [Inkscape]="org.inkscape.Inkscape"
  [Krita]="org.kde.krita"
  [OBS\ Studio]="com.obsproject.Studio"
  [Audacity]="org.audacityteam.Audacity"
  [Blender]="org.blender.Blender"
  [Telegram]="org.telegram.desktop"
  [Signal]="org.signal.Signal"
  [Discord]="com.discordapp.Discord"
  [Spotify]="com.spotify.Client"
  [Steam]="com.valvesoftware.Steam"
  ["Visual Studio Code"]="com.visualstudio.code"
  [Thunderbird]="org.mozilla.Thunderbird"
  ["Tor Browser"]="org.torproject.torbrowser-launcher"
  [Bitwarden]="com.bitwarden.Bitwarden"
  [KeePassXC]="org.keepassxc.KeePassXC"
  [Zoom]="us.zoom.Zoom"
  [Calibre]="com.calibre_ebook.calibre"
  [BleachBit]="org.bleachbit.BleachBit"
  ["OnlyOffice"]="org.onlyoffice.desktopeditors"
)

menu() {
  {
    echo "Search Flathub / جست‌وجو"
    echo "Install by ID / نصب با شناسه"
    echo "Update all / به‌روزرسانی همه"
    echo "Installed / نصب‌شده‌ها"
    for k in $(printf '%s\n' "${!APPS[@]}" | sort); do
        echo "＋ $k"
    done
  } | $R "Simorgh App Center"
}

install_id() {
    notify-send "Simorgh" "Installing $1 …" 2>/dev/null
    flatpak install -y flathub "$1" \
        && notify-send "Simorgh" "Installed: $1" 2>/dev/null \
        || notify-send "Simorgh" "Failed: $1" 2>/dev/null
}

sel=$(menu)
[[ -z "$sel" ]] && exit 0

case "$sel" in
"Search Flathub / جست‌وجو")
    q=$(echo "" | $R "Search")
    [[ -z "$q" ]] && exit 0
    pick=$(flatpak search "$q" | $R "Results")
    [[ -z "$pick" ]] && exit 0
    id=$(awk '{print $NF}' <<<"$pick")
    install_id "$id"
    ;;
"Install by ID / نصب با شناسه")
    id=$(echo "" | $R "Flatpak ID")
    [[ -n "$id" ]] && install_id "$id"
    ;;
"Update all / به‌روزرسانی همه")
    flatpak update -y
    ;;
"Installed / نصب‌شده‌ها")
    pick=$(flatpak list --app --columns=name,application | $R "Installed")
    [[ -z "$pick" ]] && exit 0
    id=$(awk '{print $NF}' <<<"$pick")
    act=$(printf 'remove\nopen\n' | $R "$id")
    [[ "$act" == "remove" ]] && flatpak uninstall -y "$id"
    [[ "$act" == "open" ]] && flatpak run "$id" &
    ;;
＋*)
    name="${sel#＋ }"
    install_id "${APPS[$name]}"
    ;;
esac
exit 0
