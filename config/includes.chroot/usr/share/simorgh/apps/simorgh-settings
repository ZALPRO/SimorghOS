#!/usr/bin/env python3
"""SimorghOS — Settings: unified hub for appearance, display, sound,
network, keyboard, time, and about."""
import os
import subprocess
import sys

sys.path.insert(0, "/usr/share/simorgh")
from gi.repository import Gtk, GLib  # noqa: E402
from ui import card, header, init, label, run_cmd, pkexec  # noqa: E402

BG_DIR = "/usr/share/backgrounds"
THEMES = [("dark", "Simorgh Dark"), ("lapis", "Lapis Blue"), ("light", "Porcelain Light")]
ACCENTS = ["#5eead4", "#38bdf8", "#a78bfa", "#f472b6", "#f0c46a", "#4ade80"]


def sh(argv):
    try:
        return subprocess.run(argv, capture_output=True, text=True, timeout=30).stdout.strip()
    except Exception:  # noqa: BLE001
        return ""


class Settings:
    def __init__(self):
        self.win = init("Settings", 940, 660)
        header(self.win, "Settings", icon="settings")
        body = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=0)
        self.win.add(body)

        side = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=0)
        side.set_size_request(220, -1)
        side.get_style_context().add_class("simorgh-sidebar")
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.stack.set_transition_duration(200)
        pages = [
            ("format-shape-appear", "Appearance", self.page_appearance),
            ("video-display", "Display", self.page_display),
            ("audio-speakers", "Sound", self.page_sound),
            ("network-wireless", "Network", self.page_network),
            ("input-keyboard", "Keyboard", self.page_keyboard),
            ("clock", "Date & Time", self.page_time),
            ("help-about", "About", self.page_about),
        ]
        for i, (icon, name, builder) in enumerate(pages):
            b = Gtk.Button(label=f"  {name}")
            b.set_relief(Gtk.ReliefStyle.NONE)
            b.set_alignment(-1, 0)
            b.set_image(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.MENU))
            b.set_always_show_image(True)
            b.connect("clicked", lambda _b, i=i: self.stack.set_visible_child_name(f"p{i}"))
            side.pack_start(b, False, False, 0)
            self.stack.add_named(builder(), f"p{i}")
        side.pack_start(Gtk.Separator(), False, False, 8)
        body.pack_start(side, False, False, 0)
        body.pack_start(self.stack, True, True, 0)
        self.win.show_all()

    # ── appearance ─────────────────────────────────────────────────────
    def page_appearance(self):
        b = card()
        b.pack_start(label("Color theme", bold=True), False, False, 0)
        self.theme_combo = Gtk.ComboBoxText()
        for val, name in THEMES:
            self.theme_combo.append_text(name)
        cur = sh(["simorgh-set-theme", "current"]) or "dark"
        self.theme_combo.set_active(max(0, [t[0] for t in THEMES].index(cur)))
        self.theme_combo.connect("changed", self.set_theme)
        b.pack_start(self.theme_combo, False, False, 2)

        b.pack_start(Gtk.Separator(), False, False, 8)
        b.pack_start(label("Wallpaper", bold=True), False, False, 0)
        self.wall_combo = Gtk.ComboBoxText()
        for f in sorted(os.listdir(BG_DIR)) if os.path.isdir(BG_DIR) else []:
            self.wall_combo.append_text(f)
        self.wall_combo.set_active(0)
        self.wall_combo.connect("changed", self.set_wallpaper)
        b.pack_start(self.wall_combo, False, False, 2)

        b.pack_start(Gtk.Separator(), False, False, 8)
        b.pack_start(label("Accent color", bold=True), False, False, 0)
        sw = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        for c in ACCENTS:
            btn = Gtk.Button(label="●")
            btn.get_style_context().add_class("swatch")
            btn.set_tooltip_text(c)
            GLib.idle_add(self._swatch_bg, btn, c)
            btn.connect("clicked", lambda _b, cc=c: self.set_accent(cc))
            sw.pack_start(btn, False, False, 0)
        b.pack_start(sw, False, False, 0)
        self.ap_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        b.pack_start(self.ap_box, False, False, 4)
        return b

    def _swatch_bg(self, btn, c):
        btn.get_style_context().set_color(Gdk.RGBA(*_hex(c)))
        return False

    def set_theme(self, combo):
        val = THEMES[combo.get_active()][0]
        run_cmd(["simorgh-set-theme", val], lambda ok, out:
                self.flash(f"Theme set to {val}" if ok else out))

    def set_wallpaper(self, combo):
        f = combo.get_active_text()
        if f:
            run_cmd(["hyprctl", "wallpaper", f"{BG_DIR}/{f},random"],
                    lambda ok, out: self.flash(f"Wallpaper: {f}"))

    def set_accent(self, c):
        run_cmd(["hyprctl", "keyword", f"general:accent = {c}"])
        self.flash(f"Accent {c} applied (live)")

    def flash(self, msg):
        self.msg.set_text(msg)
        self.msg.get_style_context().add_class("state-ok")
        for c in self.ap_box.get_children() if hasattr(self, "ap_box") else []:
            self.ap_box.remove(c)
        if hasattr(self, "ap_box"):
            self.ap_box.show_all()

    # ── display ────────────────────────────────────────────────────────
    def page_display(self):
        b = card()
        b.pack_start(label("Resolution", bold=True), False, False, 0)
        res = sh(["xrandr"]).splitlines()
        avail = [r.split()[0] for r in res if " connected" in r or "current" in r]
        self.res_combo = Gtk.ComboBoxText()
        for r in (avail or ["1920x1080"]):
            self.res_combo.append_text(r.replace("x", " × "))
        self.res_combo.connect("changed", self.set_res)
        b.pack_start(self.res_combo, False, False, 2)

        b.pack_start(Gtk.Separator(), False, False, 8)
        b.pack_start(label("Scale (fractional Hyprland)", bold=True), False, False, 0)
        self.scale_adj = Gtk.Adjustment(1.0, 0.5, 3.0, 0.25, 0.25, 0.25)
        s = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0.5, 3.0, 0.25)
        s.set_adjustment(self.scale_adj)
        s.set_digits(2)
        s.connect("value-changed", lambda a: self.set_scale(a.get_value()))
        b.pack_start(s, False, False, 2)

        b.pack_start(Gtk.Separator(), False, False, 8)
        b.pack_start(label("Refresh rate", bold=True), False, False, 0)
        self.hz_combo = Gtk.ComboBoxText()
        for h in ("60", "120", "144"):
            self.hz_combo.append_text(f"{h} Hz")
        self.hz_combo.connect("changed", self.set_hz)
        b.pack_start(self.hz_combo, False, False, 2)
        return b

    def set_res(self, combo):
        r = combo.get_active_text().replace(" × ", "x")
        run_cmd(["xrandr", "-s", r], lambda ok, out: self.flash(f"Resolution {r}"))

    def set_scale(self, v):
        run_cmd(["hyprctl", "keyword", f"dense_monitor = {0 if v > 1.2 else 1}"])

    def set_hz(self, combo):
        run_cmd(["xrandr", "--output", "eDP-1", "--rate", combo.get_active_text().split()[0]])

    # ── sound ─────────────────────────────────────────────────────────
    def page_sound(self):
        b = card()
        b.pack_start(label("Master volume", bold=True), False, False, 0)
        self.vol = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        cur = sh(["pactl", "get-sink-volume", "@DEFAULT_SINK@"])
        try:
            self.vol.set_value(int(cur.split("%")[0]))
        except Exception:  # noqa: BLE001
            self.vol.set_value(60)
        self.vol.connect("value-changed", self.set_vol)
        b.pack_start(self.vol, False, False, 2)

        b.pack_start(label("Output device", bold=True), False, False, 0)
        out = sh(["pactl", "list", "short", "sinks"]).splitlines()
        self.sink_combo = Gtk.ComboBoxText()
        for i, line in enumerate(out or ["default"]):
            self.sink_combo.append_text(line.split("\t")[1] if "\t" in line else f"Sink {i}")
        self.sink_combo.connect("changed", self.set_sink)
        b.pack_start(self.sink_combo, False, False, 2)

        b.pack_start(label("Mute", bold=True), False, False, 0)
        sw = Gtk.Switch()
        sw.connect("state-set", self.set_mute)
        b.pack_start(sw, False, False, 0)
        return b

    def set_vol(self, s):
        run_cmd(["pactl", "set-sink-volume", "@DEFAULT_SINK@", f"{int(s.get_value())}%"])

    def set_sink(self, combo):
        out = sh(["pactl", "list", "short", "sinks"]).splitlines()
        if 0 <= combo.get_active() < len(out):
            run_cmd(["pactl", "set-default-sink", out[combo.get_active()].split("\t")[0]])

    def set_mute(self, sw):
        run_cmd(["pactl", "set-sink-mute", "@DEFAULT_SINK@", "1" if sw.get_active() else "0"])
        return True

    # ── network ────────────────────────────────────────────────────────
    def page_network(self):
        b = card()
        dev = sh(["nmcli", "-t", "-f", "TYPE,DEVICE,STATE", "device"]).splitlines()
        for line in dev:
            parts = line.split(":")
            if len(parts) >= 3:
                b.pack_start(label(f"{parts[0]} · {parts[1]} — {parts[2]}", cls="dim"),
                             False, False, 0)
        b.pack_start(Gtk.Separator(), False, False, 8)
        b.pack_start(label("Wi-Fi networks", bold=True), False, False, 0)
        self.wifi_list = Gtk.ScrolledWindow()
        self.wifi_list.set_min_content_height(160)
        self.wifi_list.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        lst = Gtk.ListBox()
        lst.set_selection_mode(Gtk.SelectionMode.NONE)
        nets = sh(["nmcli", "-t", "-f", "SSID,SIGNAL", "-t", "dev", "wifi"]).splitlines()
        for n in nets[:12]:
            ssid, sig = (n.split(":") + ["?"])[:2]
            row = Gtk.ListBoxRow()
            row.add(Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8,
                            child=Gtk.Label(label=f"{ssid}   {sig}%")))
            row.get_child().set_margin_start(10); row.get_child().set_margin_top(6)
            row.get_child().set_margin_bottom(6)
            btn = Gtk.Button(label="Connect")
            btn.set_halign(Gtk.Align.END)
            btn.connect("clicked", lambda _b, s=ssid: self.connect_wifi(s))
            row.add(btn)
            lst.add(row)
        self.wifi_list.add(lst)
        b.pack_start(self.wifi_list, False, False, 0)
        return b

    def connect_wifi(self, ssid):
        d = Gtk.Dialog(title=f"Connect to {ssid}", transient_for=self.win)
        d.add_button("Cancel", Gtk.ResponseType.CANCEL)
        d.add_button("Connect", Gtk.ResponseType.OK)
        e = Gtk.Entry()
        e.set_visibility(False)
        e.set_placeholder_text("Password")
        d.get_content_area().pack_start(e, True, True, 6)
        d.show_all()
        if d.run() == Gtk.ResponseType.OK:
            pkexec(f"nmcli dev wifi connect '{ssid}' password '{e.get_text()}'",
                   lambda ok, out: self.flash("Connected" if ok else out))
        d.destroy()

    # ── keyboard ───────────────────────────────────────────────────────
    def page_keyboard(self):
        b = card()
        b.pack_start(label("Layout", bold=True), False, False, 0)
        lay = sh(["setxkbmap", "-query"])
        cur = "us"
        for line in lay.splitlines():
            if "layout" in line:
                cur = line.split("=")[1].strip() or "us"
        self.lay_combo = Gtk.ComboBoxText()
        for l in ("us", "ru", "fa", "ir", "de", "tr"):
            self.lay_combo.append_text(l)
        self.lay_combo.set_active(max(0, [l for l in ("us", "ru", "fa", "ir", "de", "tr")].index(cur)))
        self.lay_combo.connect("changed", self.set_layout)
        b.pack_start(self.lay_combo, False, False, 2)
        b.pack_start(Gtk.Separator(), False, False, 8)
        b.pack_start(label("Num Lock", bold=True), False, False, 0)
        sw = Gtk.Switch()
        sw.set_active(True)
        sw.connect("state-set", lambda s: (
            run_cmd(["xset", "numlock", "on" if s.get_active() else "off"]), True)[1])
        b.pack_start(sw, False, False, 0)
        return b

    def set_layout(self, combo):
        run_cmd(["setxkbmap", combo.get_active_text()],
                lambda ok, out: self.flash(f"Layout {combo.get_active_text()}"))

    # ── time ───────────────────────────────────────────────────────────
    def page_time(self):
        b = card()
        b.pack_start(label("Time zone", bold=True), False, False, 0)
        z = sh(["timedatectl", "list-timezones"]).splitlines()
        self.tz_combo = Gtk.ComboBoxText()
        for t in z:
            self.tz_combo.append_text(t)
        cur = sh(["timedatectl"]).split("Time zone: ")[-1].strip().splitlines()[0] if z else "Asia/Tehran"
        self.tz_combo.set_active(max(0, z.index(cur) if cur in z else 0))
        self.tz_combo.connect("changed", self.set_tz)
        b.pack_start(self.tz_combo, False, False, 2)
        b.pack_start(Gtk.Separator(), False, False, 8)
        b.pack_start(label("NTP (network clock)", bold=True), False, False, 0)
        sw = Gtk.Switch()
        sw.set_active("yes" in sh(["timedatectl"]).lower())
        sw.connect("state-set", self.set_ntp)
        b.pack_start(sw, False, False, 0)
        return b

    def set_tz(self, combo):
        pkexec(f"timedatectl set-timezone {combo.get_active_text()}",
               lambda ok, out: self.flash(f"Time zone {combo.get_active_text()}"))

    def set_ntp(self, sw):
        pkexec(f"timedatectl set-ntp {'yes' if sw.get_active() else 'no'}")
        return True

    # ── about ─────────────────────────────────────────────────────────
    def page_about(self):
        b = card()
        img = Gtk.Image.new_from_icon_name("simorgh", Gtk.IconSize.DIALOG)
        img.set_halign(Gtk.Align.CENTER)
        b.pack_start(img, False, False, 0)
        b.pack_start(label("Simorgh OS", bold=True), False, False, 0)
        b.pack_start(label("Version 0.0.1", cls="dim"), False, False, 0)
        for line in (
            "Independent Linux desktop with Hyprland, a unified app hub, "
            "and a first-class Persian/English experience.",
            "https://github.com/ZALPRO/SimorghOS",
        ):
            b.pack_start(label(line, cls="dim"), False, False, 2)
        return b


def _hex(c):
    c = c.lstrip("#")
    return tuple(int(c[i:i + 2], 16) / 255 for i in (0, 2, 4))


if __name__ == "__main__":
    from gi.repository import Gdk
    Settings()
    Gtk.main()
