#!/usr/bin/env python3
"""SimorghOS — Videos: library of ~/Videos with thumbnails, search,
duration (ffprobe), and mpv playback."""
import os
import subprocess
import sys

sys.path.insert(0, "/usr/share/simorgh")
from gi.repository import Gtk, GdkPixbuf, GLib  # noqa: E402
from ui import card, header, init, label, run_cmd  # noqa: E402

VID = os.path.expanduser("~/Videos")
EXTS = (".mp4", ".mkv", ".webm", ".avi", ".mov", ".m4v", ".ts", ".mpg", ".mpeg",
        ".wmv", ".flv", ".3gp")


def probe(path):
    try:
        out = subprocess.run(
            ["ffprobe", "-v", "quiet", "-print_format", "json",
             "-show_format", "-show_streams", path],
            capture_output=True, text=True, timeout=30).stdout
        import json
        d = json.loads(out)
        dur = float(d.get("format", {}).get("duration", 0))
        v = next((s for s in d.get("streams", []) if s.get("codec_type") == "video"), {})
        return dur, f"{v.get('width', 0)}x{v.get('height', 0)}", v.get("codec_name", "")
    except Exception:  # noqa: BLE001
        return 0, "", ""


def thumb(path):
    t = os.path.join("/tmp", "simorgh-vid-" + os.path.basename(path) + ".png")
    try:
        subprocess.run(["ffmpeg", "-y", "-v", "quiet", "-ss", "1", "-i", path,
                        "-frames:v", "1", "-vf", "scale=240:-1", t],
                       capture_output=True, timeout=60)
        if os.path.exists(t):
            return GdkPixbuf.Pixbuf.new_from_file(t)
    except Exception:  # noqa: BLE001
        pass
    return None


class Videos:
    def __init__(self):
        self.win = init("Videos", 980, 680)
        header(self.win, "Videos", icon="videos")
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.win.add(body)
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        bar.set_margin_start(10); bar.set_margin_end(10); bar.set_margin_top(8)
        self.search = Gtk.SearchEntry(placeholder_text="Search videos…")
        self.search.connect("search-changed", lambda _s: self.refresh())
        bar.pack_start(self.search, True, True, 0)
        self.count = label("", cls="dim")
        bar.pack_start(self.count, False, False, 0)
        body.pack_start(bar, False, False, 0)

        sw = Gtk.ScrolledWindow()
        sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.flow = Gtk.FlowBox()
        self.flow.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.flow.set_column_spacing(10)
        self.flow.set_row_spacing(10)
        self.flow.set_min_children_per_line(4)
        self.flow.set_max_children_per_line(6)
        self.flow.set_activate_on_single_click(True)
        self.flow.connect("activate-child", self.on_activate)
        sw.add(self.flow)
        body.pack_start(sw, True, True, 0)
        self.status = label("", cls="dim")
        self.status.set_margin_bottom(6)
        body.pack_start(self.status, False, False, 0)
        self.win.show_all()
        self.refresh()

    def files(self):
        out = []
        for root, _d, files in os.walk(VID):
            for f in files:
                if f.lower().endswith(EXTS):
                    out.append(os.path.join(root, f))
        return sorted(out)

    def refresh(self, _a=None):
        for c in self.flow.get_children():
            self.flow.remove(c)
        q = self.search.get_text().lower()
        rows = [p for p in self.files() if not q or q in os.path.basename(p).lower()]
        self.count.set_text(f"{len(rows)} videos")
        for p in rows[:200]:
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            box.set_size_request(230, -1)
            box.get_style_context().add_class("video-card")
            img = Gtk.Image()
            pb = thumb(p)
            if pb:
                img.set_from_pixbuf(pb)
            else:
                img.set_from_icon_name("video-x-generic", Gtk.IconSize.DIALOG)
            img.set_size_request(220, 124)
            box.pack_start(img, False, False, 0)
            lb = label(os.path.basename(p))
            lb.set_ellipsize(3)
            lb.set_line_wrap(False)
            box.pack_start(lb, False, False, 0)
            dur, res, _c = probe(p)
            if dur:
                h, rem = divmod(int(dur), 3600)
                m, s = divmod(rem, 60)
                meta = f"{h:d}:{m:02d}:{s:02d}" + (f"  ·  {res}" if res else "")
            else:
                meta = "unknown length"
            box.pack_start(label(meta, cls="dim"), False, False, 0)
            child = Gtk.ListBoxRow()
            child.add(box)
            child.set_data("path", p)
            self.flow.append(child)
        self.flow.show_all()
        return False

    def on_activate(self, _f, child):
        p = child.get_data("path")
        if p:
            self.status.set_text(f"Playing {os.path.basename(p)} in mpv…")
            run_cmd(["mpv", "--really-quiet", p])


if __name__ == "__main__":
    Videos()
    Gtk.main()
