#!/usr/bin/env python3
"""SimorghOS — Tweaks: live Hyprland appearance tweaks (borders, blur,
rounding, gaps, animation speed, layout, workspace behavior) with instant
preview and a reset button."""
import os
import sys

sys.path.insert(0, "/usr/share/simorgh")
from gi.repository import Gtk, GLib  # noqa: E402
from ui import card, header, init, label, run_cmd  # noqa: E402

THEME = os.path.expanduser("~/.config/simorgh/theme.conf")


def kw(section, key, value):
    return ["hyprctl", "keyword", f"{section}:{key} = {value}"]


class Tweaks:
    def __init__(self):
        self.win = init("Tweaks", 760, 700)
        header(self.win, "Tweaks", "Changes apply live to Hyprland", icon="tweaks")
        sw = Gtk.ScrolledWindow()
        sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.win.add(sw)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        col.set_margin_start(10); col.set_margin_end(10)
        col.set_margin_top(10); col.set_margin_bottom(10)
        sw.add(col)

        c = card()
        c.pack_start(label("Borders & blur", bold=True), False, False, 0)
        self.add_row(c, "Border width", 0, 4, 1, "general:border_size",
                     lambda v: f"general:border_size = {v}")
        self.add_row(c, "Active border width", 0, 4, 1, None,
                     lambda v: f"general:active_border_size = {v}")
        self.add_row(c, "Rounding", 0, 32, 2, None,
                     lambda v: f"decoration:rounding = {int(v)}")
        chk = Gtk.CheckButton(label="Blur behind windows")
        chk.set_active(True)
        chk.connect("toggled", lambda s: self._kw(
            f"decoration:blur = size 15, power 9" if s.get_active()
            else "decoration:blur = 0,0"))
        c.pack_start(chk, False, False, 2)
        chk2 = Gtk.CheckButton(label="Drop shadows")
        chk2.set_active(True)
        chk2.connect("toggled", lambda s: self._kw(
            f"decoration:drop_shadow = {'1' if s.get_active() else '0'}"))
        c.pack_start(chk2, False, False, 2)
        col.pack_start(c, False, False, 0)

        c = card()
        c.pack_start(label("Workspace & gaps", bold=True), False, False, 0)
        self.add_row(c, "Gap inside window", 0, 32, 2, None,
                     lambda v: f"gaps:inner = {v}")
        self.add_row(c, "Gap between windows", 0, 32, 2, None,
                     lambda v: f"gaps:outer = {v}")
        self.add_row(c, "Window animation scale amount", 5, 20, 1, None,
                     lambda v: f"animations:default = 1, {4 + int(v // 5)}, "
                               f"scale {1 - v / 100:.2f}")
        chk3 = Gtk.CheckButton(label="Natural touchpad scrolling")
        chk3.set_active(True)
        chk3.connect("toggled", lambda s: self._kw(
            f"input:touchpad:natural_scrolling = {'1' if s.get_active() else '0'}"))
        c.pack_start(chk3, False, False, 2)
        col.pack_start(c, False, False, 0)

        c = card()
        c.pack_start(label("Animations", bold=True), False, False, 0)
        self.add_row(c, "Animation speed (ms)", 100, 1000, 50, None,
                     lambda v: f"animations:duration = {int(v)}")
        chk4 = Gtk.CheckButton(label="Enable animations")
        chk4.set_active(True)
        chk4.connect("toggled", lambda s: self._kw(
            "animations:enabled = 1" if s.get_active() else "animations:enabled = 0"))
        c.pack_start(chk4, False, False, 2)
        col.pack_start(c, False, False, 0)

        c = card()
        c.pack_start(label("Layout & input", bold=True), False, False, 0)
        lay = Gtk.ComboBoxText()
        for l in ("dwindle", "master", "gaps"):
            lay.append_text(l)
        lay.set_active(0)
        lay.connect("changed", lambda x: self._kw(f"mainmaster:layout = {x.get_active_text()}"))
        c.pack_start(label("Layout:", cls="dim"), False, False, 0)
        c.pack_start(lay, False, False, 0)
        self.add_row(c, "Window border color opacity", 0, 255, 16, None,
                     lambda v: f"general:col.active_border = rgba({v}, {v}, {v}, ff)")
        col.pack_start(c, False, False, 0)

        reset = Gtk.Button(label="Reset to Simorgh defaults")
        reset.get_style_context().add_class("destructive-action")
        reset.connect("clicked", self.reset)
        col.pack_start(reset, False, False, 6)
        self.msg = label("", cls="dim")
        col.pack_start(self.msg, False, False, 0)
        self.win.show_all()

    def add_row(self, parent, name, lo, hi, step, _store, fmt):
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        t = label(name)
        t.set_size_request(220, -1)
        row.pack_start(t, False, False, 0)
        s = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, step)
        s.set_digits(0)
        s.connect("value-changed", lambda a: self._kw(fmt(a.get_value())))
        row.pack_start(s, True, True, 0)
        parent.pack_start(row, False, False, 0)

    def _kw(self, line):
        run_cmd(["hyprctl", "keyword", line],
                lambda ok, out: self._msg(line.split("=")[-1].strip()))

    def _msg(self, what):
        self.msg.set_text(f"Applied: {what}")
        self.msg.get_style_context().add_class("state-ok")

    def reset(self, _b):
        for line in (
            "general:border_size = 1", "general:active_border_size = 3",
            "decoration:rounding = 10", "decoration:blur = size 15, power 9",
            "decoration:drop_shadow = 1", "gaps:inner = 4", "gaps:outer = 8",
            "animations:duration = 300", "animations:enabled = 1",
            "mainmaster:layout = dwindle",
        ):
            run_cmd(["hyprctl", "keyword", line])
        self._msg("Simorgh defaults restored")


if __name__ == "__main__":
    Tweaks()
    Gtk.main()
