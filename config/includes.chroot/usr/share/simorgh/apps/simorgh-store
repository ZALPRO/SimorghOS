#!/usr/bin/env python3
"""SimorghOS — Store: unified app store (Simorgh apps, Flatpak/Flathub, APT)
with search, installed-state, progress and result feedback."""
import os
import subprocess
import sys

sys.path.insert(0, "/usr/share/simorgh")
from gi.repository import Gtk, GLib  # noqa: E402
from ui import card, header, init, label, run_cmd, pkexec  # noqa: E402

SIMGH = "/usr/share/simorgh/apps"


def sh(argv, timeout=25):
    try:
        return subprocess.run(argv, capture_output=True, text=True,
                              timeout=timeout).stdout.strip()
    except Exception:  # noqa: BLE001
        return ""


class Store:
    def __init__(self):
        self.win = init("Store", 920, 680)
        header(self.win, "Store", "Install anything — apt · flatpak · simorgh", icon="store")
        self.tab = "Simorgh"
        self.flatpak, self.apt = {}, {}
        self.spinners, self.lists = {}, {}
        self.build_ui()
        self.refresh()
        self.win.show_all()

    def build_ui(self):
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        self.win.add(body)
        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        bar.set_margin_start(10); bar.set_margin_end(10); bar.set_margin_top(8)
        group = None
        for name in ("Simorgh", "Flatpak", "APT"):
            b = Gtk.ToggleButton(label=name)
            if group is None:
                b.set_active(name == self.tab)
            else:
                b.set_group(group)
            group = b
            b.connect("toggled", self.on_tab, name)
            bar.pack_start(b, False, False, 0)
        self.search = Gtk.SearchEntry(placeholder_text="Search apps, packages…")
        self.search.connect("search-changed", lambda _s: self.refresh())
        bar.pack_start(self.search, True, True, 0)
        body.pack_start(bar, False, False, 0)

        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.CROSSFADE)
        for name in ("Simorgh", "Flatpak", "APT"):
            outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
            sp = Gtk.Spinner()
            sp.set_halign(Gtk.Align.CENTER)
            sp.set_valign(Gtk.Align.CENTER)
            sp.start()
            self.spinners[name] = sp
            outer.pack_start(sp, True, True, 0)
            sw = Gtk.ScrolledWindow()
            sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            self.lists[name] = Gtk.ListBox()
            self.lists[name].set_selection_mode(Gtk.SelectionMode.NONE)
            sw.add(self.lists[name])
            outer.pack_start(sw, True, True, 0)
            self.stack.add_named(outer, name)
        body.pack_start(self.stack, True, True, 0)

        self.status = label("Loading catalogue…", cls="dim")
        self.status.set_margin_bottom(8)
        body.pack_start(self.status, False, False, 0)

    def on_tab(self, btn, name):
        if btn.get_active():
            self.tab = name
            self.stack.set_visible_child_name(name)
            self.refresh()

    def refresh(self):
        if self.tab == "Simorgh":
            self.fill_simorgh()
        elif self.tab == "Flatpak":
            if self.flatpak:
                self.fill_generic("Flatpak", self.flatpak.items(),
                                  lambda k, v: (k, v[1], ["flatpak", "install", "-y", v[0]]),
                                  "utilities-multimedia")
            else:
                run_cmd(["flatpak", "search", "--columns=application,name,description"],
                        self._done_flatpak)
        else:
            if self.apt:
                self.fill_generic("APT", self.apt.items(),
                                  lambda k, v: (k, v, ["pkexec", "apt", "install", "-y", k]),
                                  "application-x-executable")
            else:
                run_cmd(["apt", "search", ".*"], self._done_apt)

    def _done_flatpak(self, ok, out):
        def do():
            self.flatpak.clear()
            for line in out.splitlines():
                parts = [x.strip() for x in line.split("\t")]
                if len(parts) >= 3 and "/" in parts[0]:
                    self.flatpak[parts[1]] = (parts[0], parts[2])
            if self.tab == "Flatpak":
                self.fill_generic("Flatpak", self.flatpak.items(),
                                  lambda k, v: (k, v[1], ["flatpak", "install", "-y", v[0]]),
                                  "utilities-multimedia")
            return False
        GLib.idle_add(do)

    def _done_apt(self, ok, out):
        def do():
            self.apt.clear()
            for line in out.splitlines():
                line = line.strip()
                if ":" in line:
                    name, desc = line.split(":", 1)
                    self.apt[name.strip()] = desc.strip()
            if self.tab == "APT":
                self.fill_generic("APT", self.apt.items(),
                                  lambda k, v: (k, v, ["pkexec", "apt", "install", "-y", k]),
                                  "application-x-executable")
            return False
        GLib.idle_add(do)

    def fill_simorgh(self):
        for c in self.lists["Simorgh"].get_children():
            self.lists["Simorgh"].remove(c)
        self.spinners["Simorgh"].stop()
        q = self.search.get_text().lower()
        n = 0
        for f in sorted(os.listdir(SIMGH)):
            p = f"{SIMGH}/{f}"
            if not os.path.isfile(p):
                continue
            if q and q not in (f + self._doc(p)).lower():
                continue
            self._row("Simorgh", "applications-system", f, self._doc(p),
                      None if os.path.exists(f"/usr/bin/{f}")
                      else ["pkexec", "ln", "-sf", p, f"/usr/bin/{f}"])
            n += 1
        self.lists["Simorgh"].show_all()
        self.status.set_text(f"Simorgh — {n} core apps")

    def _doc(self, path):
        try:
            with open(path, encoding="utf-8") as fh:
                for line in fh:
                    if line.startswith('"""'):
                        return line.strip().strip('"').replace("SimorghOS — ", "")[:90]
        except OSError:
            pass
        return "Simorgh app"

    def fill_generic(self, name, items, mk, icon):
        for c in self.lists[name].get_children():
            self.lists[name].remove(c)
        self.spinners[name].stop()
        q = self.search.get_text().lower()
        n = 0
        for k_, v_ in items:
            k, desc, cmd = mk(k_, v_)
            if q and q not in (k + desc).lower():
                continue
            self._row(name, icon, k, desc, cmd)
            n += 1
        self.lists[name].show_all()
        self.status.set_text(f"{name} — {n} results")

    def _row(self, tab, icon, name, desc, cmd):
        row = Gtk.ListBoxRow()
        row.get_style_context().add_class("store-row")
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
        box.set_margin_top(8); box.set_margin_bottom(8)
        box.set_margin_start(12); box.set_margin_end(8)
        box.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.LARGE_TOOLBAR),
                       False, False, 0)
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        col.pack_start(label(name, bold=True), False, False, 0)
        col.pack_start(label(desc, cls="dim"), False, False, 0)
        box.pack_start(col, True, True, 0)
        if cmd is None:
            box.pack_start(label("Installed", cls="state-ok"), False, False, 0)
        else:
            b = Gtk.Button(label="Install")
            b.connect("clicked", lambda _b, c=cmd, n=name: self.install(c, n))
            box.pack_start(b, False, False, 0)
        row.add(box)
        self.lists[tab].add(row)

    def install(self, cmd, name):
        self.status.set_text(f"Installing {name}… (this can take a minute)")
        self.status.get_style_context().add_class("state-warn")
        if cmd[0] == "pkexec":
            pkexec(" ".join(cmd[1:]), self._done(name))
        else:
            run_cmd(cmd, self._done(name))

    def _done(self, name):
        def cb(ok, out):
            def do():
                self.status.set_text(f"{'Installed' if ok else 'Error'}: {name}")
                self.status.get_style_context().remove_class("state-warn")
                self.status.get_style_context().add_class(
                    "state-ok" if ok else "state-error")
                if ok:
                    GLib.timeout_add(500, self.refresh)
                return False
            GLib.idle_add(do)
        return cb


if __name__ == "__main__":
    Store()
    Gtk.main()
