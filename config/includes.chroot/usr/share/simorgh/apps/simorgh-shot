#!/usr/bin/env python3
"""SimorghOS — Screenshot: full screen / window / area / delay, then copy·save·edit·share."""
import os
import subprocess
import sys
import time

sys.path.insert(0, "/usr/share/simorgh")
from gi.repository import Gtk  # noqa: E402
from ui import card, header, init, label, run_cmd  # noqa: E402

OUT_DIR = os.path.expanduser("~/Pictures")


class Shot:
    def __init__(self):
        self.win = init("Screenshot", 520, 560)
        header(self.win, "Screenshot", icon="screenshot")
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        root.set_margin_top(8)

        modes = card()
        modes.pack_start(label("Mode"), False, False, 2)
        self.mode = Gtk.RadioButton.new_with_label_from_widget(None, "Full Screen")
        w = Gtk.RadioButton.new_with_label_from_widget(self.mode, "Window")
        a = Gtk.RadioButton.new_with_label_from_widget(self.mode, "Area")
        for r in (self.mode, w, a):
            modes.pack_start(r, False, False, 2)
        drow = Gtk.Box(spacing=8)
        drow.pack_start(label("Delay (s)"), False, False, 4)
        self.delay = Gtk.SpinButton.new_with_range(0, 30, 1)
        drow.pack_start(self.delay, False, False, 4)
        modes.pack_start(drow, False, False, 6)
        root.pack_start(modes, False, False, 8)

        take = Gtk.Button(label="Take Screenshot")
        take.get_style_context().add_class("suggested-action")
        take.connect("clicked", lambda b: self.take())
        root.pack_start(take, False, False, 8)

        self.preview = Gtk.Image()
        self.preview.set_size_request(-1, 260)
        root.pack_start(self.preview, False, False, 8)

        after = Gtk.Box(spacing=8)
        after.set_halign(Gtk.Align.CENTER)
        self.b_copy = Gtk.Button(label="Copy")
        self.b_save = Gtk.Button(label="Save")
        self.b_edit = Gtk.Button(label="Edit")
        self.b_share = Gtk.Button(label="Share")
        for b in (self.b_copy, self.b_save, self.b_edit, self.b_share):
            b.set_sensitive(False)
            after.pack_start(b, False, False, 6)
        self.b_copy.connect("clicked", lambda b: self.copy())
        self.b_save.connect("clicked", lambda b: self.save_as())
        self.b_edit.connect("clicked", lambda b: self.edit())
        self.b_share.connect("clicked", lambda b: self.share())
        root.pack_start(after, False, False, 8)

        self.status = label("")
        root.pack_start(self.status, False, False, 4)
        self.last = None
        self.win.add(root)

    def take(self):
        d = int(self.delay.get_value())
        os.makedirs(OUT_DIR, exist_ok=True)
        path = os.path.join(OUT_DIR, f"Screenshot-{time.strftime('%F-%H%M%S')}.png")
        mode = self.mode.get_label()
        if d:
            time.sleep(0)
            self.status.set_text(f"capturing in {d}s…")
            subprocess.Popen(["sh", "-c", f"sleep {d} && " + self.cmd(mode, path)])
            from gi.repository import GLib
            GLib.timeout_add_seconds(d + 2, lambda: (self.finish(path), False))
        else:
            def done(ok, out):
                self.status.set_text(out.strip() if not ok else "")
                self.finish(path)
            run_cmd(["sh", "-c", self.cmd(mode, path)], done)

    def cmd(self, mode, path):
        if mode == "Area":
            return f'slum=$(slurp) && grim -g "$slum" "{path}"'
        if mode == "Window":
            return (f'geom=$(hyprctl activewindow | grep -oP "at: \\K.*") && '
                    f'grim -g "$geom" "{path}" 2>/dev/null || grim "{path}"')
        return f'grim "{path}"'

    def finish(self, path):
        if os.path.exists(path) and os.path.getsize(path):
            self.last = path
            self.preview.set_from_file(path)
            for b in (self.b_copy, self.b_save, self.b_edit, self.b_share):
                b.set_sensitive(True)
            self.status.set_text("saved: " + path)
            self.status.get_style_context().add_class("simorgh-success")
        else:
            self.status.set_text("capture failed")

    def copy(self):
        run_cmd(["sh", "-c", f'wl-copy < "{self.last}"'])
        self.status.set_text("copied to clipboard")

    def save_as(self):
        dlg = Gtk.FileChooserDialog("Save As", self.win, Gtk.FileChooserAction.SAVE,
                                    ("Cancel", Gtk.ResponseType.CANCEL, "Save", Gtk.ResponseType.OK))
        dlg.set_current_folder(OUT_DIR)
        dlg.set_current_name(os.path.basename(self.last))
        if dlg.run() == Gtk.ResponseType.OK:
            import shutil
            shutil.copy(self.last, dlg.get_filename())
        dlg.destroy()

    def edit(self):
        subprocess.Popen(["xdg-open", self.last])

    def share(self):
        # copy then open share-capable apps if present, else clipboard note
        self.copy()
        run_cmd(["notify-send", "-i", "screenshot", "Screenshot", "Copied — paste anywhere"])

    def run(self):
        self.win.show_all()
        Gtk.main()


if __name__ == "__main__":
    Shot().run()
