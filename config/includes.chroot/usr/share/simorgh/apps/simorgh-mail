#!/usr/bin/env python3
"""SimorghOS — Mail: launches Thunderbird; offers one-click install when absent."""
import shutil
import subprocess
import sys

sys.path.insert(0, "/usr/share/simorgh")
from gi.repository import Gtk  # noqa: E402
from ui import header, init, label  # noqa: E402


def main():
    if shutil.which("thunderbird"):
        subprocess.Popen(["thunderbird"])
        return
    win = init("Mail", 460, 300)
    header(win, "Mail", icon="mail")
    root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
    root.set_margin_top(14)
    root.set_margin_start(16)
    root.set_margin_end(16)
    root.pack_start(Gtk.Image.new_from_icon_name("mail", Gtk.IconSize.DIALOG), False, False, 4)
    t = label("Mail client is not installed yet.")
    t.set_xalign(.5)
    root.pack_start(t, False, False, 4)
    s = label("Thunderbird (inbox, sent, drafts, spam, attachments, encryption) "
              "can be installed in one click.")
    s.set_xalign(.5)
    root.pack_start(s, False, False, 4)
    b = Gtk.Button(label="Install Thunderbird")
    b.get_style_context().add_class("suggested-action")

    def go(x):
        b.set_sensitive(False)
        b.set_label("Installing…")
        from ui import run_cmd
        run_cmd(["pkexec", "apt-get", "install", "-y", "thunderbird"],
                lambda ok, out: (subprocess.Popen(["thunderbird"]) if ok else
                                 b.set_label("failed — try: simorgh install thunderbird")))
    b.connect("clicked", go)
    root.pack_start(b, False, False, 8)
    win.add(root)
    win.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
