#!/usr/bin/env python3
"""SimorghOS — Fonts: list installed fonts with live preview, install
.ttf/.otf into the user font dir, remove user-installed fonts."""
import os
import shutil
import subprocess
import sys

sys.path.insert(0, "/usr/share/simorgh")
from gi.repository import Gtk, GLib  # noqa: E402
from ui import card, header, init, label, run_cmd  # noqa: E402

USERFONTS = os.path.expanduser("~/.local/share/fonts")


def fc_list():
    try:
        out = subprocess.run(["fc-list", ":", "family,file"],
                             capture_output=True, text=True, timeout=20).stdout
    except Exception:  # noqa: BLE001
        return []
    fams = {}
    for line in out.splitlines():
        if ":" not in line:
            continue
        fam, rest = line.split(":", 1)
        file_ = rest.split(",")[0].strip()
        fams.setdefault(fam.strip(), file_)
    return sorted(fams.items())


class Fonts:
    def __init__(self):
        self.win = init("Fonts", 760, 660)
        header(self.win, "Fonts", icon="fonts")
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        body.set_margin_start(12); body.set_margin_end(12)
        body.set_margin_top(10); body.set_margin_bottom(10)
        self.win.add(body)

        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.search = Gtk.SearchEntry(placeholder_text="Search fonts…")
        self.search.connect("search-changed", lambda _s: self.refresh())
        bar.pack_start(self.search, True, True, 0)
        inst = Gtk.Button(label="Install…")
        inst.get_style_context().add_class("suggested-action")
        inst.connect("clicked", self.install)
        bar.pack_start(inst, False, False, 0)
        body.pack_start(bar, False, False, 0)

        sw = Gtk.ScrolledWindow()
        sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.lst = Gtk.ListBox()
        self.lst.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.lst.connect("row-selected", self.on_select)
        sw.add(self.lst)
        body.pack_start(sw, True, True, 0)

        self.preview = label("The quick brown fox jumps over the lazy dog. 0123456789",
                             cls="font-preview")
        self.preview.set_line_wrap(True)
        self.preview.set_margin_top(4)
        body.pack_start(self.preview, False, False, 0)
        self.status = label("", cls="dim")
        body.pack_start(self.status, False, False, 0)
        self.win.show_all()
        self.refresh()

    def refresh(self, _a=None):
        for c in self.lst.get_children():
            self.lst.remove(c)
        q = self.search.get_text().lower()
        fams = fc_list()
        if not fams:
            self.lst.add(Gtk.ListBoxRow().add(label("No fonts found.", cls="dim")))
        for fam, file_ in fams:
            if q and q not in fam.lower():
                continue
            row = Gtk.ListBoxRow()
            row.set_data("fam", fam)
            row.set_data("file", file_)
            row.add(label(fam))
            self.lst.add(row)
        self.lst.show_all()
        return False

    def on_select(self, _l, row):
        if row is None:
            return
        fam = row.get_data("fam")
        import Pango
        fd = Pango.FontDescription()
        fd.set_family(fam)
        fd.set_absolute_size(22 * Pango.SCALE)
        self.preview.override_font(fd)
        self.status.set_text(row.get_data("file"))

    def install(self, _b):
        d = Gtk.FileChooserDialog(title="Install font", transient_for=self.win,
                                  action=Gtk.FileChooserAction.OPEN)
        d.add_button("Cancel", Gtk.ResponseType.CANCEL)
        d.add_button("Install", Gtk.ResponseType.OK)
        d.set_select_multiple(True)
        d.run()
        files = d.get_filenames()
        d.destroy()
        if not files:
            return
        os.makedirs(USERFONTS, exist_ok=True)
        n = 0
        for f in files:
            if f.lower().endswith((".ttf", ".otf", ".ttc")):
                shutil.copy2(f, USERFONTS)
                n += 1
        run_cmd(["fc-cache", "-f", USERFONTS],
                lambda ok, out: (
                    self.status.set_text(f"Installed {n} font file(s)."),
                    self.status.get_style_context().add_class("state-ok"))[1])
        self.refresh()


if __name__ == "__main__":
    Fonts()
    Gtk.main()
