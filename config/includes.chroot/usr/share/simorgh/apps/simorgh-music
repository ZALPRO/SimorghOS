#!/usr/bin/env python3
"""SimorghOS — Music: library scan, playlists, queue, player (mpv IPC backend)."""
import json
import os
import socket
import subprocess
import sys
import tempfile

sys.path.insert(0, "/usr/share/simorgh")
from gi.repository import GLib, Gtk  # noqa: E402
from ui import card, header, init, label  # noqa: E402

MUSIC = os.path.expanduser("~/Music")
PL = os.path.expanduser("~/.config/simorgh/playlists.json")
EXTS = (".mp3", ".flac", ".ogg", ".opus", ".m4a", ".wav")


def _transport(icon, tip):
    b = Gtk.Button()
    b.set_tooltip_text(tip)
    b.add(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.BUTTON))
    return b


class Music:
    def __init__(self):
        self.sock_path = os.path.join(tempfile.gettempdir(), "simorgh-music.sock")
        self.mpv = None
        self.queue = []
        self.i = 0
        self.win = init("Music", 760, 640)
        header(self.win, "Music", icon="music")
        root = Gtk.Box(spacing=8)
        root.set_margin_top(8)

        # left: library
        left = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        left.set_size_request(300, -1)
        hb = Gtk.Box(spacing=6)
        self.search = Gtk.SearchEntry()
        self.search.connect("search-changed", lambda e: self.fill_lib(e.get_text()))
        hb.pack_start(self.search, True, True, 4)
        left.pack_start(hb, False, False, 4)
        self.lib_sw = Gtk.ScrolledWindow()
        self.lib = Gtk.ListBox()
        self.lib.set_selection_mode(Gtk.SelectionMode.SINGLE)
        self.lib.connect("row-activated", lambda lb, r: self.play_file(r.path))
        self.lib_sw.add(self.lib)
        left.pack_start(self.lib_sw, True, True, 0)
        plrow = Gtk.Box(spacing=6)
        self.pl_name = Gtk.Entry()
        self.pl_name.set_placeholder_text("playlist name")
        save_pl = Gtk.Button(label="Save queue as playlist")
        save_pl.connect("clicked", lambda b: self.save_playlist())
        plrow.pack_start(self.pl_name, True, True, 4)
        plrow.pack_start(save_pl, False, False, 4)
        left.pack_start(plrow, False, False, 4)
        self.pl_box = Gtk.Box(spacing=6)
        left.pack_start(self.pl_box, False, False, 4)
        root.pack_start(left, False, False, 8)

        # right: now playing + queue
        right = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.now = label("Nothing playing", size=14, bold=True)
        self.now.set_xalign(.5)
        right.pack_start(self.now, False, False, 12)
        self.pos = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
        self.pos.connect("button-release-event", lambda w, e: self.seek())
        right.pack_start(self.pos, False, False, 8)
        ctl = Gtk.Box(spacing=10)
        ctl.set_halign(Gtk.Align.CENTER)
        for ic, fn in [("back", self.prev), ("video", None), ("forward", self.next)]:
            pass
        b_prev = _transport("media-skip-backward", "Previous")
        b_play = _transport("media-playback-start", "Play / Pause")
        b_next = _transport("media-skip-forward", "Next")
        b_stop = _transport("media-playback-stop", "Stop")
        b_prev.connect("clicked", lambda b: self.prev())
        b_play.connect("clicked", lambda b: self.toggle())
        b_next.connect("clicked", lambda b: self.next())
        b_stop.connect("clicked", lambda b: self.stop())
        for b in (b_prev, b_play, b_next, b_stop):
            ctl.pack_start(b, False, False, 4)
        right.pack_start(ctl, False, False, 6)
        vol = Gtk.Box(spacing=8)
        vol.pack_start(label("Volume"), False, False, 6)
        self.vol = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 130, 1)
        self.vol.set_value(100)
        self.vol.connect("value-changed", lambda s: self.cmd(["set", "volume", str(s.get_value())]))
        vol.pack_start(self.vol, True, True, 6)
        right.pack_start(vol, False, False, 6)
        right.pack_start(label("Queue", bold=True), False, False, 8)
        self.q_sw = Gtk.ScrolledWindow()
        self.q_list = Gtk.ListBox()
        self.q_list.connect("row-activated", lambda lb, r: self.play_file(r.path))
        self.q_sw.add(self.q_list)
        right.pack_start(self.q_sw, True, True, 0)
        root.pack_start(right, True, True, 8)
        self.win.add(root)
        self.win.connect("destroy", lambda w: (self.stop(), Gtk.main_quit()))
        self.scan()
        GLib.timeout_add_seconds(1, self.poll)

    # ── library ──
    def scan(self):
        self.all = []
        if os.path.isdir(MUSIC):
            for r_, _, fs in os.walk(MUSIC):
                for f in sorted(fs):
                    if f.lower().endswith(EXTS):
                        self.all.append(os.path.join(r_, f))
        self.fill_lib("")
        self.fill_playlists()

    def fill_lib(self, q):
        for c in list(self.lib.get_children()):
            self.lib.remove(c)
        for p in self.all:
            if q and q.lower() not in p.lower():
                continue
            lb = Gtk.ListBoxRow()
            lb.path = p
            box = Gtk.Box(spacing=6)
            box.pack_start(Gtk.Image.new_from_icon_name("music", Gtk.IconSize.MENU), False, False, 4)
            box.pack_start(label(os.path.relpath(p, MUSIC)), True, True, 4)
            add = Gtk.Button(label="+")
            add.set_relief(Gtk.ReliefStyle.NONE)
            add.connect("clicked", lambda b, p=p: self.enqueue(p))
            box.pack_end(add, False, False, 2)
            lb.add(box)
            self.lib.add(lb)
        self.lib.show_all()

    def fill_playlists(self):
        for c in list(self.pl_box.get_children()):
            self.pl_box.remove(c)
        try:
            pls = json.load(open(PL))
        except Exception:
            pls = {}
        for name, items in pls.items():
            b = Gtk.Button(label="▸ " + name)
            b.connect("clicked", lambda x, i=items: (self.queue.clear(),
                                  [self.enqueue(p, quiet=True) for p in i], self.next_first()))
            self.pl_box.pack_start(b, False, False, 3)
        self.pl_box.show_all()

    def save_playlist(self):
        name = self.pl_name.get_text().strip()
        if not name:
            return
        try:
            pls = json.load(open(PL))
        except Exception:
            pls = {}
        pls[name] = list(self.queue)
        os.makedirs(os.path.dirname(PL), exist_ok=True)
        json.dump(pls, open(PL, "w"))
        self.fill_playlists()

    # ── playback (mpv IPC) ──
    def start_mpv(self):
        if self.mpv and self.mpv.poll() is None:
            return
        self.mpv = subprocess.Popen(["mpv", "--idle=yes", "--input-ipc-server=" + self.sock_path],
                                    stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    def cmd(self, args):
        self.start_mpv()
        try:
            s = socket.socket(socket.AF_UNIX)
            s.connect(self.sock_path)
            s.sendall((json.dumps({"command": args}) + "\n").encode())
            data = s.recv(65536)
            s.close()
            return json.loads(data or b"{}")
        except Exception:
            return {}

    def enqueue(self, p, quiet=False):
        if p not in self.queue:
            self.queue.append(p)
            row = Gtk.ListBoxRow()
            row.path = p
            row.add(label(os.path.basename(p)))
            self.q_list.add(row)
            self.q_list.show_all()

    def next_first(self):
        self.i = -1
        self.next()

    def play_file(self, p):
        self.start_mpv()
        self.cmd(["loadfile", p, "replace"])
        self.now.set_text(os.path.basename(p))

    def toggle(self):
        self.cmd(["cycle", "pause"])

    def stop(self):
        self.cmd(["stop"])

    def next(self):
        if not self.queue:
            return
        self.i = (self.i + 1) % len(self.queue)
        self.play_file(self.queue[self.i])

    def prev(self):
        if not self.queue:
            return
        self.i = (self.i - 1) % len(self.queue)
        self.play_file(self.queue[self.i])

    def seek(self):
        self.cmd(["seek", str(self.pos.get_value()), "absolute-percent"])

    def poll(self):
        r = self.cmd(["get_property", "percent-pos"])
        if "error" not in r and isinstance(r.get("data"), (int, float)):
            self.pos.set_value(r["data"])
        return True


if __name__ == "__main__":
    Music().win.show_all()
    Gtk.main()
