#!/usr/bin/env python3
"""SimorghOS — Welcome: first-boot wizard (language, timezone, keyboard,
wallpaper, suggested apps, done). Persists choices; runs once by default."""
import os
import sys

sys.path.insert(0, "/usr/share/simorgh")
from gi.repository import Gtk, GLib  # noqa: E402
from ui import card, header, init, label, run_cmd, pkexec  # noqa: E402

DONE = os.path.expanduser("~/.config/simorgh/.welcomed")


class Welcome:
    def __init__(self):
        self.win = init("Welcome to Simorgh OS", 860, 620)
        self.win.set_resizable(False)
        header(self.win, "Welcome", icon="welcome")
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        self.win.add(outer)
        self.stack = Gtk.Stack()
        self.stack.set_transition_type(Gtk.StackTransitionType.SLIDE_LEFT_RIGHT)
        self.stack.set_transition_duration(250)
        outer.pack_start(self.stack, True, True, 0)
        nav = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        nav.set_margin_start(12); nav.set_margin_end(12)
        nav.set_margin_bottom(12); nav.set_margin_top(6)
        self.back_b = Gtk.Button(label="Back")
        self.back_b.connect("clicked", self.go_back)
        nav.pack_start(self.back_b, False, False, 0)
        self.progress = label("Step 1 of 5", cls="dim")
        nav.pack_start(self.progress, True, True, 0)
        self.next_b = Gtk.Button(label="Next")
        self.next_b.get_style_context().add_class("suggested-action")
        self.next_b.connect("clicked", self.go_next)
        nav.pack_start(self.next_b, False, False, 0)
        outer.pack_start(nav, False, False, 0)

        self.pages = [
            self.p_hello(), self.p_lang(), self.p_time(),
            self.p_keyboard(), self.p_finish(),
        ]
        for i, p in enumerate(self.pages):
            self.stack.add_named(p, f"p{i}")
        self.i = 0
        self._upd_nav()
        self.win.show_all()

    def _upd_nav(self):
        self.stack.set_visible_child_name(f"p{self.i}")
        self.progress.set_text(f"Step {self.i + 1} of {len(self.pages)}")
        self.back_b.set_sensitive(self.i > 0)
        self.next_b.set_label("Finish" if self.i == len(self.pages) - 1 else "Next")

    def go_next(self, _b):
        if self.i == 1:
            self.apply_lang()
        elif self.i == 2:
            self.apply_tz()
        elif self.i == 3:
            self.apply_kb()
        if self.i < len(self.pages) - 1:
            self.i += 1
            self._upd_nav()
        else:
            self.finish()

    def go_back(self, _b):
        if self.i > 0:
            self.i -= 1
            self._upd_nav()

    # ── pages ──────────────────────────────────────────────────────────
    def p_hello(self):
        c = card()
        c.set_halign(Gtk.Align.CENTER)
        img = Gtk.Image.new_from_icon_name("simorgh", Gtk.IconSize.DIALOG)
        img.set_halign(Gtk.Align.CENTER)
        c.pack_start(img, False, False, 10)
        c.pack_start(label("Welcome to Simorgh OS", bold=True), False, False, 0)
        c.pack_start(label("سیمرغ — a calm, fast, independent Linux desktop.\n"
                           "Let's set it up in under a minute.", cls="dim"),
                     False, False, 4)
        self.skip = Gtk.CheckButton(label="I've done this before — skip the wizard")
        self.skip.set_halign(Gtk.Align.CENTER)
        self.skip.connect("toggled", lambda s: self.finish() if s.get_active() else None)
        c.pack_start(self.skip, False, False, 10)
        return c

    def p_lang(self):
        c = card()
        c.pack_start(label("Language", bold=True), False, False, 0)
        c.pack_start(label("Choose your default UI language. You can change it "
                           "anytime with `simorgh lang <code>`.", cls="dim"),
                     False, False, 2)
        self.lang = Gtk.ComboBoxText()
        for code, name in (("en", "English"), ("fa", "فارسی (Persian)")):
            self.lang.append_text(name)
        cur = open(os.path.expanduser("~/.config/simorgh/lang"), "r").read().strip() \
            if os.path.exists(os.path.expanduser("~/.config/simorgh/lang")) else "en"
        self.lang.set_active(1 if cur == "fa" else 0)
        c.pack_start(self.lang, False, False, 4)
        return c

    def p_time(self):
        c = card()
        c.pack_start(label("Time zone", bold=True), False, False, 0)
        c.pack_start(label("Your clock, dates and the Persian calendar all follow "
                           "this zone.", cls="dim"), False, False, 2)
        self.tz = Gtk.ComboBoxText()
        import subprocess
        z = subprocess.run(["timedatectl", "list-timezones"], capture_output=True,
                           text=True).stdout.splitlines()
        for t in z:
            self.tz.append_text(t)
        guess = "Asia/Tehran"
        for t in z:
            if "Tehran" in t:
                guess = t
                break
        self.tz.set_active(max(0, z.index(guess) if guess in z else 0))
        c.pack_start(self.tz, False, False, 4)
        return c

    def p_keyboard(self):
        c = card()
        c.pack_start(label("Keyboard layout", bold=True), False, False, 0)
        c.pack_start(label("Persian (Standard) can be switched with Super+Space "
                           "if you add both layouts.", cls="dim"), False, False, 2)
        self.kb = Gtk.ComboBoxText()
        for l in ("us", "fa", "ir", "de", "tr", "ru"):
            self.kb.append_text(l)
        self.kb.set_active(0)
        c.pack_start(self.kb, False, False, 4)
        self.kb_both = Gtk.CheckButton(label="Add both US and Persian (Super+Space switch)")
        c.pack_start(self.kb_both, False, False, 0)
        return c

    def p_finish(self):
        c = card()
        c.pack_start(label("You're all set", bold=True), False, False, 0)
        tips = [
            "Super key  — open the launcher (Spotlight)",
            "Print  — screenshot · Alt+Print — window · Ctrl+Print — area",
            "simorgh  — the command hub: apps, theme, language, backup…",
            "simorgh center  — settings, store, and every system tool",
        ]
        for t in tips:
            c.pack_start(label("•  " + t, cls="dim"), False, False, 2)
        self.apps_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        c.pack_start(label("Install optional extras:", cls="dim"), False, False, 6)
        for name, pkg in (("LibreOffice", "libreoffice"), ("Thunderbird", "thunderbird"),
                          ("VLC", "vlc")):
            b = Gtk.CheckButton(label=name)
            b.set_data("pkg", pkg)
            self.apps_row.pack_start(b, False, False, 0)
        c.pack_start(self.apps_row, False, False, 0)
        return c

    # ── apply ──────────────────────────────────────────────────────────
    def apply_lang(self):
        code = "fa" if self.lang.get_active() == 1 else "en"
        run_cmd(["simorgh", "lang", code])

    def apply_tz(self):
        pkexec(f"timedatectl set-timezone {self.tz.get_active_text()}")

    def apply_kb(self):
        l = self.kb.get_active_text()
        if self.kb_both.get_active():
            run_cmd(["setxkbmap", "us,fa"])
        else:
            run_cmd(["setxkbmap", l])

    def finish(self):
        for b in self.apps_row.get_children():
            if b.get_active():
                run_cmd(["pkexec", "apt", "install", "-y", b.get_data("pkg")])
        os.makedirs(os.path.expanduser("~/.config/simorgh"), exist_ok=True)
        open(DONE, "w").write("1")
        Gtk.main_quit()


if __name__ == "__main__":
    if os.path.exists(DONE) and "--force" not in sys.argv:
        sys.exit(0)
    Welcome()
    Gtk.main()
