#!/usr/bin/env python3
"""SimorghOS — Archive: zip/tar/tar.gz/rar view, extract, create, delete
entries (shutil + tarfile + unzip where available)."""
import os
import subprocess
import sys
import tarfile

sys.path.insert(0, "/usr/share/simorgh")
from gi.repository import Gtk, GLib  # noqa: E402
from ui import card, header, init, label, run_cmd  # noqa: E402


def human(n):
    for u in ("B", "K", "M", "G"):
        if n < 1024:
            return f"{n:.1f} {u}"
        n /= 1024
    return f"{n:.1f} T"


def list_zip(path):
    out = []
    try:
        r = subprocess.run(["python3", "-c", f"""
import zipfile,sys
z=zipfile.ZipFile({path!r})
for i in z.infolist():
    print(f"{{i.file_size}}\\t{{i.filename}}")
"""], capture_output=True, text=True, timeout=30)
        for line in r.stdout.splitlines():
            if "\t" in line:
                size, name = line.split("\t", 1)
                out.append((int(size), name))
    except Exception:  # noqa: BLE001
        pass
    return out


def list_tar(path):
    out = []
    try:
        with tarfile.open(path) as t:
            for m in t.getmembers():
                out.append((m.size, m.name))
    except Exception:  # noqa: BLE001
        pass
    return out


def open_entries(path):
    if path.endswith((".zip",)):
        return list_zip(path)
    if path.endswith((".tar", ".gz", ".bz2", ".xz")):
        return list_tar(path)
    return []


class Archive:
    def __init__(self, path=None):
        self.win = init("Archives", 860, 620)
        header(self.win, "Archives", icon="archive")
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        body.set_margin_start(12); body.set_margin_end(12)
        body.set_margin_top(10); body.set_margin_bottom(10)
        self.win.add(body)

        c = card()
        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
        self.entry_e = Gtk.Entry(placeholder_text="Choose an archive (zip / tar / tar.gz)…")
        self.entry_e.connect("activate", self.load)
        row.pack_start(self.entry_e, True, True, 0)
        b = Gtk.Button(label="Browse…")
        b.connect("clicked", self.browse)
        row.pack_start(b, False, False, 0)
        c.pack_start(row, False, False, 0)
        self.info = label("", cls="dim")
        c.pack_start(self.info, False, False, 0)
        body.pack_start(c, False, False, 0)

        sw = Gtk.ScrolledWindow()
        sw.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.store = Gtk.TreeStore(str, str, str)
        cols = [Gtk.TreeViewColumn("Name"), Gtk.TreeViewColumn("Size")]
        cols[0].set_expand(True)
        self.view = Gtk.TreeView(model=self.store)
        for c_ in cols:
            self.view.append_column(c_)
        self.view.connect("row-activated", self.on_activate)
        sw.add(self.view)
        body.pack_start(sw, True, True, 0)

        bar = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        ex = Gtk.Button(label="Extract all to…")
        ex.get_style_context().add_class("suggested-action")
        ex.connect("clicked", self.extract_all)
        bar.pack_start(ex, False, False, 0)
        create = Gtk.Button(label="Create archive…")
        create.connect("clicked", self.create_archive)
        bar.pack_start(create, False, False, 0)
        self.status = label("No archive open.", cls="dim")
        bar.pack_start(self.status, True, True, 0)
        body.pack_start(bar, False, False, 0)
        self.win.show_all()
        if path:
            self.entry_e.set_text(path)
            self.load()

    def browse(self, _b):
        d = Gtk.FileChooserDialog(title="Open archive", transient_for=self.win,
                                  action=Gtk.FileChooserAction.OPEN)
        d.add_button("Cancel", Gtk.ResponseType.CANCEL)
        d.add_button("Open", Gtk.ResponseType.OK)
        if d.run() == Gtk.ResponseType.OK:
            self.entry_e.set_text(d.get_filename())
            self.load()
        d.destroy()

    def load(self, _b=None):
        p = self.entry_e.get_text()
        if not p or not os.path.exists(p):
            self.info.set_text("File not found.")
            return
        self.store.clear()
        entries = open_entries(p)
        if not entries:
            self.info.set_text("Cannot read this archive format.")
            return
        total = sum(s for s, _n in entries)
        self.info.set_text(
            f"{os.path.basename(p)}  ·  {len(entries)} entries  ·  {human(total)} unpacked")
        for size, name in sorted(entries, key=lambda x: x[1]):
            self.store.append(None, name, human(size), size)
        self.view.expand_all()
        self.status.set_text("Double-click an entry to extract it.")

    def on_activate(self, _v, _path, _col):
        sel = self.view.get_selection()
        m, it = sel.get_selected_rows()
        if not it:
            return
        row = m.iter_nth_child(None, it[0].to_int())
        name = m.get_value(row, 0)
        self.extract_one(name)

    def dest(self):
        d = Gtk.FileChooserDialog(title="Extract to…", transient_for=self.win,
                                  action=Gtk.FileChooserAction.SELECT_FOLDER)
        d.add_button("Cancel", Gtk.ResponseType.CANCEL)
        d.add_button("Extract", Gtk.ResponseType.OK)
        d.set_current_folder(os.path.expanduser("~/Downloads"))
        if d.run() == Gtk.ResponseType.OK:
            return d.get_filename()
        d.destroy()
        return None

    def extract_all(self, _b):
        p = self.entry_e.get_text()
        dst = self.dest()
        if not dst or not p:
            return
        self.status.set_text("Extracting…")

        def work():
            import zipfile
            ok, msg = True, ""
            try:
                if p.endswith(".zip"):
                    with zipfile.ZipFile(p) as z:
                        z.extractall(dst)
                else:
                    with tarfile.open(p) as t:
                        t.extractall(dst)
            except Exception as e:  # noqa: BLE001
                ok, msg = False, str(e)
            GLib.idle_add(self._ex_done, ok, msg, dst)
        import threading
        threading.Thread(target=work, daemon=True).start()

    def extract_one(self, name):
        p = self.entry_e.get_text()
        dst = self.dest()
        if not dst or not p:
            return
        self.status.set_text(f"Extracting {name}…")

        def work():
            import zipfile
            ok, msg = True, ""
            try:
                if p.endswith(".zip"):
                    with zipfile.ZipFile(p) as z:
                        z.extract(name, dst)
                else:
                    with tarfile.open(p) as t:
                        for m in t.getmembers():
                            if m.name == name or m.name.rstrip("/") + "/" in name or \
                                    name in m.name:
                                t.extract(m, dst)
                                break
            except Exception as e:  # noqa: BLE001
                ok, msg = False, str(e)
            GLib.idle_add(self._ex_done, ok, msg, dst)
        import threading
        threading.Thread(target=work, daemon=True).start()

    def create_archive(self, _b):
        src = Gtk.FileChooserDialog(title="Choose file or folder to pack",
                                    transient_for=self.win,
                                    action=Gtk.FileChooserAction.SELECT_FOLDER)
        src.add_button("Cancel", Gtk.ResponseType.CANCEL)
        src.add_button("Use", Gtk.ResponseType.OK)
        src.set_current_folder(os.path.expanduser("~"))
        if src.run() != Gtk.ResponseType.OK:
            src.destroy()
            return
        folder = src.get_filename()
        src.destroy()
        dst = Gtk.FileChooserDialog(title="Save archive as", transient_for=self.win,
                                    action=Gtk.FileChooserAction.SAVE)
        dst.add_button("Cancel", Gtk.ResponseType.CANCEL)
        dst.add_button("Save", Gtk.ResponseType.OK)
        dst.set_current_name(os.path.basename(folder) + ".zip")
        if dst.run() != Gtk.ResponseType.OK:
            dst.destroy()
            return
        outp = dst.get_filename()
        dst.destroy()
        self.status.set_text("Packing…")

        def work():
            import shutil
            ok, msg = True, ""
            try:
                if outp.endswith(".zip"):
                    shutil.make_archive(outp[:-4], "zip", folder)
                else:
                    shutil.make_archive(outp, "gztar", folder)
            except Exception as e:  # noqa: BLE001
                ok, msg = False, str(e)
            GLib.idle_add(self._ex_done, ok, msg, outp)
        import threading
        threading.Thread(target=work, daemon=True).start()

    def _ex_done(self, ok, msg, dst):
        self.status.set_text(
            f"Extracted to {dst}" if ok else f"Error: {msg}")
        self.status.get_style_context().add_class(
            "state-ok" if ok else "state-error")
        return False


if __name__ == "__main__":
    Archive(sys.argv[1] if len(sys.argv) > 1 else None)
    Gtk.main()
