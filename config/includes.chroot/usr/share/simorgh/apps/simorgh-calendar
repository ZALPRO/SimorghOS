#!/usr/bin/env python3
"""SimorghOS — Calendar: Jalali + Gregorian month views, events & reminders."""
import calendar
import datetime as dt
import json
import os
import sys

sys.path.insert(0, "/usr/share/simorgh")
from jalaali import to_gregorian, to_jalaali  # noqa: E402
from gi.repository import Gtk  # noqa: E402
from ui import card, header, init, label  # noqa: E402

EV = os.path.expanduser("~/.config/simorgh/events.json")
FA = ["فروردین", "اردیبهشت", "خرداد", "تیر", "مرداد", "شهریور",
      "مهر", "آبان", "آذر", "دی", "بهمن", "اسفند"]
WD_FA = ["ش", "ی", "د", "س", "چ", "پ", "ج"]
WD_EN = ["Mo", "Tu", "We", "Th", "Fr", "Sa", "Su"]


def load():
    try:
        return json.load(open(EV))
    except Exception:
        return {}


def save(d):
    os.makedirs(os.path.dirname(EV), exist_ok=True)
    json.dump(d, open(EV, "w"), ensure_ascii=False)


class Cal:
    def __init__(self):
        self.events = load()
        self.today = dt.date.today()
        self.jy, self.jm, self.jd = to_jalaali(self.today.year, self.today.month, self.today.day)
        self.win = init("Calendar", 900, 640)
        header(self.win, "Calendar", icon="calendar")
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        root.set_margin_top(8)
        # nav
        nav = Gtk.Box(spacing=8)
        nav.set_halign(Gtk.Align.CENTER)
        self.prev = Gtk.Button(label="‹")
        self.next = Gtk.Button(label="›")
        self.title = label("", size=15, bold=True)
        self.today_b = Gtk.Button(label="Today")
        self.prev.connect("clicked", lambda b: self.move(-1))
        self.next.connect("clicked", lambda b: self.move(1))
        self.today_b.connect("clicked", lambda b: self.go_today())
        for w in (self.prev, self.title, self.next, self.today_b):
            nav.pack_start(w, False, False, 8)
        root.pack_start(nav, False, False, 6)
        self.panes = Gtk.Box(spacing=10)
        self.panes.set_margin_start(8)
        self.panes.set_margin_end(8)
        root.pack_start(self.panes, True, True, 6)
        # events row
        ev = Gtk.Box(spacing=8)
        self.ev_entry = Gtk.Entry()
        self.ev_entry.set_placeholder_text("New event for selected day / رویداد جدید…")
        add = Gtk.Button(label="Add event")
        add.connect("clicked", lambda b: self.add_event())
        ev.pack_start(self.ev_entry, True, True, 8)
        ev.pack_start(add, False, False, 8)
        root.pack_start(ev, False, False, 8)
        self.sel = self.today.isoformat()
        self.ev_list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        root.pack_start(self.ev_list, False, False, 4)
        self.win.add(root)
        self.draw()

    def move(self, d):
        self.jm += d
        if self.jm < 1:
            self.jm, self.jy = 12, self.jy - 1
        if self.jm > 12:
            self.jm, self.jy = 1, self.jy + 1
        self.draw()

    def go_today(self):
        self.jy, self.jm, self.jd = to_jalaali(self.today.year, self.today.month, self.today.day)
        self.draw()

    def j_month_days(self):
        gy, gm, gd = to_gregorian(self.jy, self.jm, 1)
        first = dt.date(gy, gm, gd)
        n = 31 if self.jm <= 6 else (30 if self.jm <= 11 else 29)
        return first, n

    def draw(self):
        for c in list(self.panes.get_children()):
            self.panes.remove(c)
        self.title.set_text(f"{FA[self.jm - 1]} {self.jy}  ·  {calendar.month_name[self.g_month()[1]]} {self.g_month()[0]}")
        self.panes.pack_start(self.grid_jalali(), True, True, 4)
        self.panes.pack_start(self.grid_greg(), True, True, 4)
        self.draw_events()
        self.panes.show_all()

    def g_month(self):
        first, _ = self.j_month_days()
        return first.year, first.month

    def grid_jalali(self):
        box = card()
        hd = Gtk.Box()
        for w in WD_FA:
            l = label(w, bold=True); l.set_xalign(.5)
            hd.pack_start(l, True, True, 0)
        box.pack_start(hd, False, False, 4)
        first, n = self.j_month_days()
        lead = (first.weekday() + 1) % 7  # Saturday first
        row = Gtk.Box()
        for _ in range(lead):
            row.pack_start(label(""), True, True, 0)
        for d in range(1, n + 1):
            b = Gtk.Button(label=str(d))
            b.set_relief(Gtk.ReliefStyle.NONE)
            key = dt.date(*to_gregorian(self.jy, self.jm, d)).isoformat()
            if key in self.events and self.events[key]:
                b.get_style_context().add_class("suggested-action")
            if d == self.jd:
                b.get_style_context().add_class("state-ok")
            b.connect("clicked", lambda bt, k=key: self.select(k))
            row.pack_start(b, True, True, 0)
            if (lead + d) % 7 == 0:
                box.pack_start(row, False, False, 2)
                row = Gtk.Box()
        if (lead + n) % 7:
            box.pack_start(row, False, False, 2)
        return box

    def grid_greg(self):
        box = card()
        y, m = self.g_month()
        hd = Gtk.Box()
        for w in WD_EN:
            l = label(w, bold=True); l.set_xalign(.5)
            hd.pack_start(l, True, True, 0)
        box.pack_start(hd, False, False, 4)
        cal = calendar.Calendar(firstweekday=0)
        for week in cal.monthdatescalendar(y, m):
            row = Gtk.Box()
            for day in week:
                if day.month != m:
                    row.pack_start(label(""), True, True, 0)
                    continue
                b = Gtk.Button(label=str(day.day))
                b.set_relief(Gtk.ReliefStyle.NONE)
                if day.isoformat() in self.events and self.events[day.isoformat()]:
                    b.get_style_context().add_class("suggested-action")
                if day == self.today:
                    b.get_style_context().add_class("state-ok")
                b.connect("clicked", lambda bt, k=day.isoformat(): self.select(k))
                row.pack_start(b, True, True, 0)
            box.pack_start(row, False, False, 2)
        return box

    def select(self, key):
        self.sel = key
        self.draw_events()

    def add_event(self):
        txt = self.ev_entry.get_text().strip()
        if not txt:
            return
        self.events.setdefault(self.sel, []).append(txt)
        save(self.events)
        self.ev_entry.set_text("")
        self.draw()

    def draw_events(self):
        for c in list(self.ev_list.get_children()):
            self.ev_list.remove(c)
        jy, jm, jd = to_jalaali(*[int(x) for x in self.sel.split("-")])
        head = label(f"{self.sel}  ·  {jd} {FA[jm - 1]} {jy}")
        self.ev_list.pack_start(head, False, False, 2)
        for i, e in enumerate(self.events.get(self.sel, [])):
            row = Gtk.Box(spacing=6)
            row.pack_start(label("• " + e), True, True, 6)
            rm = Gtk.Button(icon="window-close"); rm.set_relief(Gtk.ReliefStyle.NONE)
            rm.connect("clicked", lambda b, i=i: self.rm_event(i))
            row.pack_end(rm, False, False, 2)
            self.ev_list.pack_start(row, False, False, 1)
        self.ev_list.show_all()

    def rm_event(self, i):
        self.events[self.sel].pop(i)
        save(self.events)
        self.draw()

    def run(self):
        self.win.show_all()
        Gtk.main()


if __name__ == "__main__":
    Cal().run()
