// سیمرغ‌اواس — نوار وضعیت Waybar (آیکون‌های Font Awesome، بدون ایموجی)
{
    "layer": "top",
    "position": "top",
    "height": 38,
    "spacing": 8,
    "margin-top": 8,
    "margin-left": 10,
    "margin-right": 10,

    "modules-left": ["custom/logo", "hyprland/workspaces", "hyprland/window"],
    "modules-right": ["tray", "network", "bluetooth", "pulseaudio", "cpu", "memory", "custom/jdate", "clock"],

    "custom/logo": {
        "format": " Simorgh",
        "tooltip": false,
        "on-click": "rofi -show drun",
        "on-right-click": "rofi -show run"
    },

    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": false,
        "format": "{icon}",
        "format-icons": {
            "1": "۱", "2": "۲", "3": "۳", "4": "۴", "5": "۵",
            "6": "۶", "7": "۷", "8": "۸", "9": "۹", "10": "۱۰"
        },
        "persistent-workspaces": { "*": 5 }
    },

    "hyprland/window": {
        "max-length": 60,
        "separate-outputs": true
    },

    "tray": { "spacing": 10 },

    "network": {
        "format-wifi": "\uf1eb",
        "format-ethernet": "\uf1ac",
        "format-disconnected": "\uf6ac",
        "tooltip-format": "{essid} — {ipaddr}"
    },

    "bluetooth": {
        "format": "\uf294",
        "format-disabled": "",
        "tooltip-format": "{status}"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "\uf6a9",
        "format-icons": { "default": ["\uf027", "\uf028", "\uf028"] },
        "on-click": "pavucontrol"
    },

    "cpu": { "format": "\uf2db {usage}%", "interval": 5 },
    "memory": { "format": "\uf538 {percentage}%", "interval": 5 },

    "custom/jdate": {
        "format": "\uf073 {}",
        "exec": "/usr/share/simorgh/bin/simorgh-jdate --short",
        "interval": 60,
        "tooltip-format": "تقویم جلالی"
    },

    "clock": {
        "format": "\uf017 {:%H:%M}",
        "tooltip-format": "{:%A %d %B %Y}\n{calendar}",
        "calendar": { "mode": "month" }
    }
}
