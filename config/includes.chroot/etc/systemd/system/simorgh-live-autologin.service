# SimorghOS — live sessions boot straight into the desktop.
# QA boot flags (documented for screenshot automation):
#   simorgh-shot=calamares          open the installer after login
#   simorgh-shot=simorgh-<app>      open that core app after login
[Unit]
Description=SimorghOS live autologin
DefaultDependencies=no
After=local-fs.target live-config.service
Before=lightdm.service
ConditionKernelCommandLine=boot=live

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '
  sed -i "s/^autologin-user=.*/autologin-user=user/" /etc/lightdm/lightdm.conf;
  mkdir -p /etc/xdg/autostart;
  flag=$(sed -n "s/.*simorgh-shot=\([^ ]*\).*/\1/p" /proc/cmdline | head -1);
  if [ -n "$flag" ]; then
    name=$flag; [ "$flag" = calamares ] && name=installer;
    printf "[Desktop Entry]\nType=Application\nName=%s\nExec=sh -c \"sleep 10; %s\"\nX-GNOME-Autostart-enabled=true\n" \
      "$name" "$flag" > "/etc/xdg/autostart/simorgh-qa-$name.desktop";
  fi'

[Install]
WantedBy=multi-user.target
